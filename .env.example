# Copy this file to .env.local and fill in your own values from your Supabase project settings.
# Never commit .env.local to GitHub - it's already covered by .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used in server-side code (never exposed to the browser). Keep this out of any
# client component. Found in Supabase: Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
